{
  "name": "tts-listener",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch server/index.js",
    "build": "vite build",
    "serve": "bun run server/index.js",
    "start": "bun run build && bun run serve",
    "test": "node --test tests/*.test.mjs && npm run typecheck",
    "typecheck": "tsc -p jsconfig.json --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "alpinejs": "^3.15.0",
    "kokoro-js": "^1.2.1",
    "marked": "^18.1.1",
    "tinykeys": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
