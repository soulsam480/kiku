{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "listener",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "vars": {
    "LLM_HOSTS": "opencode.ai,api.openai.com,openrouter.ai"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
