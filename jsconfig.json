{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "alpinejs": [
        "./src/types/alpinejs.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "worker/**/*.js",
    "tests/**/*.mjs",
    "tests/**/*.js",
    "vite.config.js"
  ]
}
